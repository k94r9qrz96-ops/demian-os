# ===== Demian OS · configuración (sin secretos reales) =====
# Copiá este archivo a .env (o cargá estas variables como secretos en tu proveedor). Nunca lo subas a git.

PUBLIC_URL=https://tu-dominio.com          # URL pública con HTTPS (necesaria para webhooks y OAuth)
PORT=8787
SESSION_SECRET=                            # openssl rand -base64 48
APP_ENCRYPTION_KEY=                        # openssl rand -base64 32  (cifra tokens OAuth en la base)

# Primer arranque: crea tu usuario dueño. Borrá ADMIN_PASSWORD después (o usá `npm run create-admin`).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Demian

# ===== Claude (API) =====  console.anthropic.com → API Keys. Una suscripción a claude.ai NO incluye API.
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-sonnet-5-5
WORKER_MODEL=claude-sonnet-5-5
LIGHT_MODEL=claude-haiku-5-5

# ===== Límites de gasto (USD) =====
LIMIT_TASK_USD=1.5
LIMIT_DAILY_USD=10
LIMIT_MONTHLY_USD=120

# ===== Chatwoot + WhatsApp oficial =====
CHATWOOT_BASE_URL=                         # ej. https://app.chatwoot.com o tu instancia
CHATWOOT_ACCOUNT_ID=
CHATWOOT_USER_TOKEN=                       # Perfil → Token de acceso (usuario administrador)
CHATWOOT_BOT_TOKEN=                        # Ajustes → Bots → token del Agent Bot
CHATWOOT_WEBHOOK_SECRET=                   # secreto HMAC del bot/webhook
CHATWOOT_URL_TOKEN=                        # opcional: token extra en la URL /webhooks/chatwoot/<token>
CHATWOOT_INBOX_COMPANY_MAP=                # ej. 12:elite-hunters,13:rushy,14:yazak
CHATWOOT_DIRECTOR_INBOX_ID=                # opcional: inbox exclusivo para tu canal de dirección
# CHATWOOT_AUTH_STYLE=bearer               # solo Chatwoot ≥ 4.19

# ===== Google (Gmail, Calendar, Drive) =====  console.cloud.google.com → Credenciales → OAuth (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tu-dominio.com/oauth/google/callback

# ===== Metricool (plan Advanced/Custom) =====
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
# METRICOOL_SCHEDULER_VERIFIED=1 y METRICOOL_SCHEDULER_PATH=… solo cuando confirmes el endpoint de programación
