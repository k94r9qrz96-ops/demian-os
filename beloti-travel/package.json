{
  "name": "beloti-travel",
  "version": "1.0.0",
  "private": true,
  "description": "Beloti Travel — landing page cinematográfica (Next.js, exportação estática)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@14 out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "images": "node scripts/build-images.mjs",
    "media": "bash scripts/build-media.sh",
    "preview:file": "next build --webpack && node scripts/build-preview.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "d3-geo": "3.1.1",
    "gsap": "3.13.0",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/d3-geo": "3.1.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
