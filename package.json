{
  "name": "demian-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demian OS — oficina virtual de agentes para dirigir Elite Hunters HR, Rushy AI y Yazak Media",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "demo": "DEMO_MODE=1 node --no-warnings=ExperimentalWarning server/index.js",
    "build": "cd web && npm run build",
    "create-admin": "node --no-warnings=ExperimentalWarning scripts/create-admin.js",
    "migrate": "node --no-warnings=ExperimentalWarning scripts/migrate.js",
    "test": "node --no-warnings=ExperimentalWarning --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.3.2"
  }
}
